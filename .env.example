# Aplicación
APP_NAME="FastAPI Starter"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# PostgreSQL: credenciales de ejemplo para desarrollo local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_starter

# Frontend: lista JSON de orígenes permitidos, sin slash final.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Autenticación: generar una clave y colocarla en el .env
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Pruebas: base exclusiva y descartable; debe terminar en _test.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_starter_test
